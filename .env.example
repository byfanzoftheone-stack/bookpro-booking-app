# Placeholders only. Set real values in the Netlify dashboard, never in git.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
SITE_URL=https://your-site.netlify.app
# Human approval gate: checkout stays in STUB mode unless this is exactly "yes".
LIVE_CHECKOUT_APPROVED=no
# Price IDs created by the owner in Stripe (owner must approve pricing first)
STRIPE_PRICE_STARTER=price_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME
# Per-IP requests per minute for the checkout function
RATE_LIMIT_PER_MIN=5
# Stripe webhook (endpoint: /.netlify/functions/stripe-webhook). Secret from the Stripe dashboard; never commit.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Local/test ONLY: allow the ephemeral JSON store. Netlify's filesystem is wiped; licenses WILL be lost.
# Leave unset in production: the webhook returns 503 until a persistent store is wired in.
ALLOW_EPHEMERAL_STORE=no
# LICENSE_DB=./data/licenses.json
