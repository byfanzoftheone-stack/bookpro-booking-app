# Placeholders only. Set real values in the Netlify dashboard, never in git.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
SITE_URL=https://your-site.netlify.app
# Human approval gate: checkout stays in STUB mode unless this is exactly "yes".
LIVE_CHECKOUT_APPROVED=no
# Price IDs created by the owner in Stripe (owner must approve pricing first)
STRIPE_PRICE_STARTER=price_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME
# Per-IP requests per minute for the checkout function
RATE_LIMIT_PER_MIN=5
# Stripe webhook (endpoint: /.netlify/functions/stripe-webhook). Secret from the Stripe dashboard; never commit.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# REQUIRED in production: Postgres (Neon, Supabase, RDS, Railway...). Without it the webhook answers 503 (fail closed).
# The plaintext key sits in license_outbox until delivered: protect this database like a secret store.
LICENSE_DATABASE_URL=postgres://USER:PASSWORD@HOST/DB
# LICENSE_DATABASE_SSL=require
# LICENSE_DB_POOL_MAX=5
# DEV ONLY (ignored/refused when NODE_ENV=production or on Netlify's runtime; not for production):
# LICENSE_DB=./data/dev.sqlite     (or .json)      LICENSE_DEV_STORE=memory
